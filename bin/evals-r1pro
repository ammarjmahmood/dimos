#!/usr/bin/env bash
# Run the R1 Pro manipulation cases once per agent arm this machine can run, then
# print one table comparing them. Arms without their API key or CLI are skipped.
#
#   bin/evals-r1pro                      # open space, seed 5000
#   SCENE=apartment TAGS=seed5001 bin/evals-r1pro
#   MODEL=gpt-5.6-sol bin/evals-r1pro    # model for Pi and dimcode

set -uo pipefail

SCENE=${SCENE:-open_space}
TAGS=${TAGS:-seed5000}
MODEL=${MODEL:-gpt-5.6-luna}
suite="dimos.evals.suites.r1pro_${SCENE}"
blueprint="r1pro-classical-${SCENE//_/-}-sim-agent"
runs=()

run() {
    echo "== $*"
    local summary
    summary=$(dimos evals run "$suite" --tags "$TAGS" "$@" | tee /dev/stderr | grep " cases | mean " | tail -1)
    # The summary's last field is the run directory.
    [ -n "$summary" ] && runs+=("${summary##* }")
}

. .venv/bin/activate
run --agent dimos.evals.agents.scripted_plan
if [ -n "${OPENAI_API_KEY:-}" ]; then
    run --agent dimos.evals.agents.mcp_client_adapter --set "modules=[\"$blueprint\"]"
fi
if [ -n "${TYPESAFE_API_KEY:-}" ]; then
    run --agent dimos.evals.agents.jev_planner
fi
if [ -n "${OPENAI_API_KEY:-}" ] && command -v pi > /dev/null; then
    run --agent dimos.evals.agents.pi --set "model=$MODEL"
fi
if [ -n "${OPENAI_API_KEY:-}" ] && command -v dimcode > /dev/null; then
    run --agent dimos.evals.agents.dimcode --set "model=$MODEL"
fi
dimos evals compare "${runs[@]}"
